# ─── CORE (required) ──────────────────────────────────────────────────────────
# Note: must be .env, not .env.local (pnpm db:setup writes this file)
POSTGRES_URL=postgresql://***
BASE_URL=http://localhost:3000

# ─── AUTH — default (custom JWT) ──────────────────────────────────────────────
AUTH_SECRET=***   # min 32 chars — run: openssl rand -hex 32

# ─── AUTH — Supabase (inject auth-supabase) ───────────────────────────────────
# NEXT_PUBLIC_SUPABASE_URL=https://***.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=***
# SUPABASE_SERVICE_ROLE_KEY=***

# ─── AUTH — Clerk (inject auth-clerk) ─────────────────────────────────────────
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_***
# CLERK_SECRET_KEY=sk_test_***

# ─── AUTH — NextAuth (inject auth-nextauth) ───────────────────────────────────
# NEXTAUTH_SECRET=***
# NEXTAUTH_URL=http://localhost:3000

# ─── PAYMENTS — Stripe (default) ──────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_***
STRIPE_WEBHOOK_SECRET=whsec_***

# ─── PAYMENTS — MercadoPago (inject payments-mercadopago) ─────────────────────
# MP_ACCESS_TOKEN=***
# NEXT_PUBLIC_MP_PUBLIC_KEY=***
# MP_WEBHOOK_SECRET=***

# ─── EMAIL ────────────────────────────────────────────────────────────────────
RESEND_API_KEY=re_***
RESEND_FROM_EMAIL=onboarding@resend.dev

# ─── STORAGE — Supabase (inject storage-supabase) ─────────────────────────────
# SUPABASE_STORAGE_BUCKET=uploads

# ─── STORAGE — S3 (inject storage-s3) ────────────────────────────────────────
# AWS_BUCKET=***
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=***
# AWS_SECRET_ACCESS_KEY=***

# ─── ANALYTICS (optional, no-op if missing) ───────────────────────────────────
# NEXT_PUBLIC_POSTHOG_KEY=phc_***
